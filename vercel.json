{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.12"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "installCommand": "apt-get update && apt-get install -y cmake g++ libboost-all-dev && pip install --no-cache-dir -r requirements.txt"
}