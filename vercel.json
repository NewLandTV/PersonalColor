{
    "version": 2,
    "functions": {
        "api/**/*.js": {
            "runtime": "@vercel/node",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "builds": {
        "env": {
            "NODE_PATH": "node_modules"
        }
    },
    "installCommand": "npm install"
}